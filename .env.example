# Copy this file to .env (in the same folder as manage.py) and fill in your own values.
# .env is private to your computer and must never be committed to git.

# A long random string Django uses to sign login cookies. Make your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# How to reach your MySQL server. DB_PASSWORD is the root password you chose
# when you installed MySQL.
DB_NAME=tuckshop_dev
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# The password for the demo logins that `python manage.py seed` creates
# (owner, admin and cashier). For development only. At least 8 characters.
SEED_PASSWORD=change-me
